{
  "name": "web-learn-dvorak-react",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "clean": "rm -rf dist node_modules",
